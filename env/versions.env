# Pinned versions, for reproducibility. After changing them, re-run `make up && make check`.
# Verified on 2026-11-04.
KIND_CLUSTER=kursinis
KUBE_PROMETHEUS_STACK_VERSION=92.13.1
LOKI_CHART_VERSION=7.5.0
ALLOY_CHART_VERSION=1.14.3
PODINFO_IMAGE=ghcr.io/stefanprodan/podinfo:6.15.0
# The alert receiver (Go) is built locally from Dockerfile.receiver and loaded into kind.
RECEIVER_IMAGE=diag-agent/alert-receiver:dev
LOADGEN_IMAGE=busybox:1.37
KIND_NODE_IMAGE=kindest/node:v1.37.0  # kind v0.33.0; digest pinned in kind-config.yaml
